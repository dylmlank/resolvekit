# ResolveKit configuration — copy to .env and fill in as needed.

# Where generated scripts / media / stills land.
RESOLVEKIT_OUTPUT=E:\resolvekit\output

# --- Electron panel backend (server.py) ---
RESOLVEKIT_HOST=127.0.0.1
RESOLVEKIT_PORT=8765

# --- Media generation provider ---
# Options: local (PIL+numpy gradient images + tone audio) or stub (placeholder cards)
# Default: local (falls back to stub if deps missing)
# RESOLVEKIT_PROVIDER=local

# --- Resolve scripting API paths (only set if Resolve is installed non-default) ---
# RESOLVE_SCRIPT_API=C:\ProgramData\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting
# RESOLVE_SCRIPT_LIB=C:\Program Files\Blackmagic Design\DaVinci Resolve\fusionscript.dll

# --- Optional: terminal agent.py (MCP + panel drive Claude directly) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# RESOLVEKIT_MODEL=openai/gpt-oss-120b:free
